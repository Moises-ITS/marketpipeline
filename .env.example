# Copy this file to `.env` and adjust if needed. `.env` is gitignored because in a real project
# it holds secrets (API keys, database passwords); `.env.example` is committed so a reviewer
# knows which variables exist without ever seeing your values.
#
# Every value here has a working default in marketdata/config.py - this file exists to make the
# knobs discoverable, not because the app fails without it.

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Size of the API's Redis connection pool. Connections are borrowed and returned, so this is a
# concurrency ceiling, not a per-request cost.
REDIS_MAX_CONNECTIONS=50

# --- TimescaleDB -------------------------------------------------------------
# NOTE the port: 5434, not the usual 5432. See docker-compose.yml for why.
# This string is a DSN ("data source name"): driver://user:password@host:port/database
PG_DSN=postgresql://marketdata:marketdata@localhost:5434/marketdata

# Postgres forks a process per connection, so an oversized pool costs memory and contention
# rather than buying speed.
PG_MAX_CONNECTIONS=10

# --- Market data feed --------------------------------------------------------
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com

# Comma-separated. Coinbase calls these product IDs: BASE-QUOTE.
SYMBOLS=BTC-USD,ETH-USD,SOL-USD

# --- Ingestion ---------------------------------------------------------------
# Cap on each per-symbol Redis Stream (XTRIM). Bigger = more history served from memory, more
# memory used. Anything older falls back to TimescaleDB automatically.
STREAM_MAXLEN=5000

# Batched writes to TimescaleDB: flush on whichever trigger fires first.
PG_BATCH_SIZE=200
PG_FLUSH_SECONDS=2.0

# --- API ---------------------------------------------------------------------
# Hard ceiling on ?limit= for the history endpoint, so no single request can ask for the world.
MAX_HISTORY_LIMIT=5000

# BENCHMARK CONTROL, not a feature. `true` forces /history to skip Redis and always query
# TimescaleDB - the "before" half of loadtest/RESULTS.md. Leave it false in normal use.
HISTORY_FORCE_DB=false

# --- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO
